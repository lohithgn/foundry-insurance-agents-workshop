# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env   (PowerShell:  Copy-Item .env.example .env)
#
# Auth uses AzureCliCredential — you MUST run `az login` first. No keys go in this file.

# Your Foundry project endpoint, e.g.
#   https://<resource>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT=

# The deployed chat model name from Lab 00 (e.g. gpt-4.1)
MODEL_DEPLOYMENT_NAME=gpt-4.1

# Policy document uploaded as Agent 1's knowledge (Lab 01).
# Default points at the workshop's synthetic homeowners policy.
POLICY_FILE_PATH=../../data/markdown/HOME-2024-00871-homeowners.md

# Optional naming tag so assets don't collide in a shared project (e.g. jd).
# Leave blank to use plain names (claims-assessor, customer-response).
INITIALS=

# Set to true to delete the agents / vector store / file at the end of a run.
# Keep false so Lab 03 can reuse the agents created by Labs 01 and 02.
CLEANUP=false
